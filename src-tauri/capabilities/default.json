{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Document windows (main and one per file opened while running)",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
